# Firebase console: projeto > configurações > Seus apps > app Web.
# Apenas configuração pública do cliente. Não inserir chave de serviço ou client_secret.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth: cliente WEB para ID token; cliente iOS para SDK e esquema de retorno.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# O padrão em app.json é com.taysonaraujo.bibliasmart nas duas plataformas.
# Deixe vazio para usar o padrão. Preencha somente para substituir antes de publicar.
# Registrar os identificadores efetivos no Firebase/Google quando ativar o login.
APP_ANDROID_PACKAGE=
APP_IOS_BUNDLE_IDENTIFIER=

# Premium automático no Expo Go/APK preview durante a fase de testes, sem cobrança.
# false desativa localmente. O perfil EAS production desativa a liberação.
APP_PREMIUM_TEST_ACCESS=true

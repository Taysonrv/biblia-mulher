{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_PREMIUM_TEST_ACCESS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_PREMIUM_TEST_ACCESS": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "production",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_PREMIUM_TEST_ACCESS": "false"
      },
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

{
  "expo": {
    "name": "Bíblia VP",
    "slug": "biblia-mulher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/palavra-luz-v1/app-icon.png",
    "scheme": "bibliamulher",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.taysonaraujo.bibliasmart",
      "icon": "./assets/brand/palavra-luz-v1/app-icon.png"
    },
    "android": {
      "package": "com.taysonaraujo.bibliasmart",
      "adaptiveIcon": {
        "backgroundColor": "#243E32",
        "foregroundImage": "./assets/brand/palavra-luz-v1/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/palavra-luz-v1/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/palavra-luz-v1/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/palavra-luz-v1/notification.png",
          "color": "#243E32"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#243E32",
          "image": "./assets/brand/palavra-luz-v1/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "BibliaSmartWord",
              "label": "Bíblia VP — Palavra",
              "description": "Salmos 23:1 e atalhos para Bíblia e Harpa Cristã.",
              "minWidth": "280dp",
              "minHeight": "200dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#243E32",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1115f2c-bec7-44b4-852d-9d69c60bb24e"
      }
    }
  }
}
